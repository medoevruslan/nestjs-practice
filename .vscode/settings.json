{
  "jest.virtualFolders": [
    {
      "name": "unit",
      "jestCommandLine": "pnpm test",
      "runMode": "watch"
    },
    {
      "name": "e2e",
      "jestCommandLine": "./node_modules/jest/bin/jest.js --config ./test/jest-e2e.json",
      "runMode": "on-demand",
      "nodeEnv": {
        "NODE_ENV": "testing"
      }
    }
  ],
  "eslint.enable": true,
  "eslint.validate": ["javascript", "typescript"],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  }
}
